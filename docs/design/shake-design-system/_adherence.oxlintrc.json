{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/communication/**",
              "components/containment/**",
              "components/navigation/**",
              "components/selection/**",
              "components/shake/**",
              "components/textinputs/**",
              "ui_kits/shake-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Roboto Flex|Roboto Mono|Material Symbols Rounded))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Roboto Flex, Roboto Mono, Material Symbols Rounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|status|icon|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, status, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:safe|missing|unconfirmed|injured|none)$/]",
        "message": "<Avatar> status must be one of 'safe' | 'missing' | 'unconfirmed' | 'injured' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|dot|max|color|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: count, dot, max, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:error|primary|tertiary)$/]",
        "message": "<Badge> color must be one of 'error' | 'primary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeaconControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|active|disabled|onActivate|onStop|size|key|ref|className|style|children)$/]",
        "message": "<BeaconControl> doesn't accept that prop. Declared props: mode, active, disabled, onActivate, onStop, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeaconControl'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:sos|search)$/]",
        "message": "<BeaconControl> mode must be one of 'sos' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|height|onDismiss|children|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: open, title, height, onDismiss, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|trailingIcon|fullWidth|loading|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, trailingIcon, fullWidth, loading, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|tonal|elevated|outlined|text|danger)$/]",
        "message": "<Button> variant must be one of 'filled' | 'tonal' | 'elevated' | 'outlined' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg)$/]",
        "message": "<Button> size must be one of 'xs' | 'sm' | 'md' | 'lg'."
