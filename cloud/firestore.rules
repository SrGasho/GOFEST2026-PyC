rules_version = '2';

// Toda escritura pasa por Cloud Functions con Admin SDK (que ignora estas
// reglas). Los clientes solo leen datos ya consolidados.
service cloud.firestore {
  match /databases/{database}/documents {
    match /findings/{findingId} {
      allow read, write: if false;
    }

    match /people/{emergencyId} {
      allow read: if true;
      allow write: if false;
    }

    match /shelters/{shelterId} {
      allow read: if true;
      allow write: if false;
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
